SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key shown in the Supabase API settings.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# For legacy projects, SUPABASE_ANON_KEY can be used instead.
# SUPABASE_ANON_KEY=your-supabase-anon-key

# Override only if your schema uses different ownership columns.
# Defaults match the current Supabase schema: events.organiser_id and registrations.student_id.
# EVENT_OWNER_COLUMN=organizer_id
# REGISTRATION_USER_COLUMN=user_id
